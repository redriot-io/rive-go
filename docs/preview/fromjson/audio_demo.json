{
  "version": 1,
  "artboard": {
    "name": "AudioDemo",
    "width": 400,
    "height": 300,
    "fonts": [{"name": "Abel", "file": "abel.ttf"}],
    "audios": [
      {"name": "click", "file": "silence.wav"}
    ],
    "children": [
      {
        "type": "rectangle",
        "name": "background",
        "x": 200,
        "y": 150,
        "width": 400,
        "height": 300,
        "fill": "#1a1d27"
      },
      {
        "type": "rectangle",
        "name": "button",
        "x": 200,
        "y": 150,
        "width": 160,
        "height": 60,
        "corner_radius": 12,
        "fill": "#4ecdc4"
      },
      {
        "type": "text",
        "name": "label",
        "x": 200,
        "y": 158,
        "style": {"font": "Abel", "fontSize": 24, "fill": "#1a1d27"},
        "text": "Play"
      }
    ],
    "animations": [
      {
        "name": "pulse",
        "duration": 1.0,
        "fps": 60,
        "loop": "pingpong",
        "tracks": [
          {
            "target": "button.scaleX",
            "keyframes": [
              {"time": 0.0, "value": 1.0,  "easing": "ease-in-out"},
              {"time": 0.5, "value": 1.05, "easing": "ease-in-out"},
              {"time": 1.0, "value": 1.0,  "easing": "ease-in-out"}
            ]
          },
          {
            "target": "button.scaleY",
            "keyframes": [
              {"time": 0.0, "value": 1.0,  "easing": "ease-in-out"},
              {"time": 0.5, "value": 1.05, "easing": "ease-in-out"},
              {"time": 1.0, "value": 1.0,  "easing": "ease-in-out"}
            ]
          }
        ]
      },
      {
        "name": "flash",
        "duration": 0.3,
        "fps": 60,
        "loop": "oneshot",
        "tracks": [
          {
            "target": "button.fill.color",
            "keyframes": [
              {"time": 0.0,  "value": "#FF4ecdc4"},
              {"time": 0.15, "value": "#FFff6b6b"},
              {"time": 0.3,  "value": "#FF4ecdc4"}
            ]
          }
        ]
      }
    ],
    "state_machines": [
      {
        "name": "PlaySM",
        "inputs": [
          {"name": "clicked", "type": "bool", "default": false}
        ],
        "layers": [
          {
            "name": "Main",
            "states": [
              {"name": "idle",  "animation": "pulse"},
              {"name": "flash", "animation": "flash"}
            ],
            "transitions": [
              {
                "from": "idle",  "to": "flash", "duration_ms": 0,
                "conditions": [{"input": "clicked", "value": true}]
              },
              {
                "from": "flash", "to": "idle",  "duration_ms": 0,
                "conditions": [{"input": "clicked", "value": false}]
              }
            ]
          }
        ],
        "listeners": [
          {
            "target": "button",
            "event": "pointer_down",
            "actions": [{"type": "set_bool", "input": "clicked", "value": true}]
          },
          {
            "target": "button",
            "event": "pointer_up",
            "actions": [{"type": "set_bool", "input": "clicked", "value": false}]
          }
        ]
      }
    ]
  }
}
