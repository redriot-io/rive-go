{
  "version": 1,
  "artboard": {
    "name": "DrawOrderDemo",
    "width": 400,
    "height": 300,
    "children": [
      {
        "type": "rectangle",
        "name": "red",
        "x": 130,
        "y": 150,
        "width": 180,
        "height": 180,
        "corner_radius": 14,
        "fill": "#E53935"
      },
      {
        "type": "rectangle",
        "name": "green",
        "x": 200,
        "y": 150,
        "width": 180,
        "height": 180,
        "corner_radius": 14,
        "fill": "#43A047",
        "draw_rules": [
          { "type": "above", "target": "red" },
          { "type": "above", "target": "blue" }
        ]
      },
      {
        "type": "rectangle",
        "name": "blue",
        "x": 310,
        "y": 150,
        "width": 180,
        "height": 180,
        "corner_radius": 14,
        "fill": "#1E88E5"
      }
    ],
    "animations": [
      {
        "name": "slide",
        "duration": 2.0,
        "fps": 60,
        "loop": "pingpong",
        "tracks": [
          {
            "target": "blue.x",
            "keyframes": [
              { "time": 0.0, "value": 310, "easing": "ease-in-out" },
              { "time": 2.0, "value": 80,  "easing": "ease-in-out" }
            ]
          }
        ]
      }
    ]
  }
}
