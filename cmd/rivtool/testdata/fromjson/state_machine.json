{
  "version": 1,
  "artboard": {
    "name": "Toggle",
    "width": 400,
    "height": 400,
    "children": [
      {
        "type": "ellipse",
        "name": "btn",
        "x": 200,
        "y": 200,
        "width": 100,
        "height": 100,
        "fill": "#3498DB"
      }
    ],
    "animations": [
      {
        "name": "toOn",
        "duration": 0.3,
        "fps": 60,
        "loop": "oneshot",
        "tracks": [
          {
            "target": "btn.fill.color",
            "keyframes": [
              { "time": 0.0, "value": "#3498DB", "easing": "ease-out" },
              { "time": 0.3, "value": "#2ECC71" }
            ]
          }
        ]
      },
      {
        "name": "toOff",
        "duration": 0.3,
        "fps": 60,
        "loop": "oneshot",
        "tracks": [
          {
            "target": "btn.fill.color",
            "keyframes": [
              { "time": 0.0, "value": "#2ECC71", "easing": "ease-out" },
              { "time": 0.3, "value": "#3498DB" }
            ]
          }
        ]
      }
    ],
    "state_machines": [
      {
        "name": "ToggleSM",
        "inputs": [
          { "name": "isOn", "type": "bool" }
        ],
        "layers": [
          {
            "name": "main",
            "states": [
              { "name": "off", "animation": "toOff" },
              { "name": "on",  "animation": "toOn"  }
            ],
            "transitions": [
              {
                "from": "off",
                "to": "on",
                "conditions": [{ "input": "isOn", "value": true }]
              },
              {
                "from": "on",
                "to": "off",
                "conditions": [{ "input": "isOn", "value": false }]
              }
            ]
          }
        ]
      }
    ]
  }
}
